{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite-plus/client"],
    "customConditions": ["@akshatowo/radical/source"],
    "resolveJsonModule": true
  },
  "include": ["src", "vite.config.ts", "plugins", ".radical/plugins.d.ts"]
}
